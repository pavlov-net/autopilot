{
  "name": "autopilot",
  "version": "0.2.0",
  "type": "module",
  "description": "Fully autonomous AI development loop using Claude Code + Linear",
  "scripts": {
    "start": "bun run src/main.ts",
    "setup": "bun run src/setup-project.ts",
    "explain": "bun run src/explain.ts",
    "validate": "bun run src/validate.ts",
    "sync-templates": "bun run src/sync-templates.ts",
    "test": "bun test",
    "check": "bunx biome check ./src",
    "typecheck": "bunx tsc --noEmit",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@linear/sdk": "^97.1.0",
    "hono": "^4.13.13",
    "octokit": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
